---
import Analytics from '@vercel/analytics/astro';
import { contacts } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '章徳川 · 笔记与思考',
  description = '章徳川的个人博客，记录技术、阅读与生活中的思考。',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <title>{title}</title>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="返回首页">DC<span>.</span></a>
      <nav aria-label="主导航">
        <a href="/">文章</a>
        <a href="/about/">关于</a>
        <a class="search-link" href="/search/" aria-label="搜索文章">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
          搜索
        </a>
        <details class="contact-menu">
          <summary>联系 <span aria-hidden="true">+</span></summary>
          <div class="contact-popover">
            <p>保持联系</p>
            <ul>
              {contacts.map((contact) => (
                <li>
                  <a href={contact.href} target={contact.external ? '_blank' : undefined} rel={contact.external ? 'noreferrer' : undefined}>
                    <span>{contact.label}</span>
                    <small>{contact.detail}</small>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© {new Date().getFullYear()} 章徳川 · 写给好奇心</p>
    </footer>
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <button class="back-to-top" type="button" aria-label="返回顶部" hidden>↑</button>
    <Analytics />
    <script>
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const motionEnabled = document.documentElement.classList.contains('motion-ready');

      if (!motionEnabled || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries, currentObserver) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('is-visible');
              currentObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        revealItems.forEach((item) => observer.observe(item));
      }

      const topButton = document.querySelector<HTMLButtonElement>('.back-to-top');
      const progress = document.querySelector<HTMLElement>('.reading-progress');
      const isArticle = document.querySelector('.post') !== null;

      const updateScrollUI = () => {
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 0;
        if (isArticle && progress) progress.style.setProperty('--reading-progress', String(Math.min(ratio, 1)));
        if (topButton) topButton.hidden = window.scrollY < 560;
      };

      topButton?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      window.addEventListener('scroll', updateScrollUI, { passive: true });
      updateScrollUI();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #20221f;
    --muted: #73766e;
    --paper: #f8f7f2;
    --line: #deddd5;
    --accent: #d9603c;
    font-family: ui-serif, Georgia, Cambria, "Noto Serif SC", "Songti SC", serif;
    color: var(--ink);
    background: var(--paper);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  .site-header, main, footer { width: min(100% - 3rem, 760px); margin: 0 auto; }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 0;
    font-family: ui-sans-serif, system-ui, sans-serif;
  }
  .brand { font-weight: 800; font-size: 1.2rem; text-decoration: none; letter-spacing: -.08em; }
  .brand span { color: var(--accent); }
  nav { align-items: center; display: flex; gap: 1.25rem; font-size: .9rem; }
  nav a { text-decoration: none; }
  .search-link { align-items: center; display: inline-flex; gap: .3rem; }
  .search-link svg { fill: none; height: .9rem; stroke: currentColor; stroke-linecap: round; stroke-width: 1.8; width: .9rem; }
  .contact-menu { position: relative; }
  .contact-menu summary { cursor: pointer; list-style: none; }
  .contact-menu summary::-webkit-details-marker { display: none; }
  .contact-menu summary span { color: var(--accent); display: inline-block; margin-left: .1rem; transition: transform .18s ease; }
  .contact-menu[open] summary span { transform: rotate(45deg); }
  .contact-popover { animation: menu-in .16s ease-out; background: var(--ink); box-shadow: 0 12px 32px rgba(32, 34, 31, .16); color: var(--paper); min-width: 13rem; padding: 1rem; position: absolute; right: 0; top: calc(100% + .85rem); z-index: 20; }
  .contact-popover p { color: #bfc0b8; font-size: .7rem; letter-spacing: .1em; margin: 0 0 .6rem; text-transform: uppercase; }
  .contact-popover ul { list-style: none; margin: 0; padding: 0; }
  .contact-popover li + li { border-top: 1px solid rgba(248, 247, 242, .16); }
  .contact-popover a { display: flex; flex-direction: column; gap: .15rem; padding: .7rem 0; text-decoration: none; }
  .contact-popover a:hover { color: var(--paper); }
  .contact-popover small { color: #bfc0b8; font-size: .72rem; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-.35rem); } to { opacity: 1; transform: translateY(0); } }
  footer {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    margin-top: 5rem;
    padding: 1.5rem 0 3rem;
    color: var(--muted);
    font: .8rem ui-sans-serif, system-ui, sans-serif;
  }
  footer p { margin: 0; }
  .reading-progress { background: transparent; height: 3px; inset: 0 0 auto; pointer-events: none; position: fixed; transform-origin: left; width: 100%; z-index: 10; }
  .reading-progress span { background: var(--accent); display: block; height: 100%; transform: scaleX(var(--reading-progress, 0)); transform-origin: left; }
  .back-to-top { align-items: center; background: var(--accent); border: 0; border-radius: 999px; bottom: 1.5rem; box-shadow: 0 .45rem 1.2rem rgb(217 96 60 / 28%); color: var(--paper); cursor: pointer; display: grid; font: 1.2rem ui-sans-serif, system-ui, sans-serif; height: 2.65rem; justify-content: center; position: fixed; right: max(1.5rem, calc((100vw - 820px) / 2)); transition: filter .15s ease, transform .15s ease; width: 2.65rem; z-index: 5; }
  .back-to-top:hover { filter: brightness(.88); transform: translateY(-.2rem); }
  .back-to-top:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .motion-ready [data-reveal] { opacity: 0; transform: translateY(1rem); transition: opacity .6s ease var(--reveal-delay, 0ms), transform .6s cubic-bezier(.2,.65,.25,1) var(--reveal-delay, 0ms); }
  .motion-ready [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  @media (max-width: 500px) {
    .site-header, main, footer { width: min(100% - 2rem, 760px); }
    footer { align-items: flex-start; gap: .75rem; flex-direction: column; }
    .back-to-top { bottom: 1rem; right: 1rem; }
  }
</style>
