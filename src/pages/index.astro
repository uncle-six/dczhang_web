---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { tagUrl } from '../utils/tags';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout>
  <section class="intro" data-reveal>
    <p class="eyebrow">个人博客 · DCZHANG.ME</p>
    <h1>记录那些值得</h1>
    <h1><em>反复想想</em> 的事</h1>
    <p class="lede">你好，我是章德川。</p>
    <p class="lede">这里保存我对阅读、远行和技术的思考🤔</p>
  </section>

  <section aria-labelledby="posts-heading">
    <div class="section-title" data-reveal>
      <h2 id="posts-heading">最新文章</h2>
      <span>{posts.length} 篇</span>
    </div>
    <div class="post-list">
      {posts.map((post, index) => (
        <article data-reveal style={`--reveal-delay: ${Math.min(index * 70, 280)}ms`}>
          <div class="post-card">
            <div class="post-content">
              <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
              <h3><a href={`/posts/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="tags">{post.data.tags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}</div>
            </div>
            <a class="arrow" href={`/posts/${post.id.replace(/\.md$/, '')}/`} aria-label={`阅读文章：${post.data.title}`}>↗</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding: 6.5rem 0 5rem; }
  .eyebrow { color: var(--accent); font: 700 .72rem ui-sans-serif, system-ui, sans-serif; letter-spacing: .12em; }
  h1 { font-size: clamp(2.8rem, 8vw, 5rem); font-weight: 500; letter-spacing: -.075em; line-height: 1.05; margin: 1rem 0 1.6rem; }
  h1 em { color: var(--accent); font-style: normal; font-weight: inherit; white-space: nowrap; }
  .lede { color: var(--muted); font-size: 1.08rem; line-height: 1.8; max-width: 32rem; }
  .section-title { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid var(--ink); }
  h2 { font: 700 .78rem ui-sans-serif, system-ui, sans-serif; letter-spacing: .1em; margin: 0 0 .8rem; }
  .section-title span { color: var(--muted); font: .78rem ui-sans-serif, system-ui, sans-serif; }
  .post-list article { border-bottom: 1px solid var(--line); }
  .post-card { align-items: center; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; padding: 2rem 0; transition: transform .2s ease; }
  .post-content { min-width: 0; }
  time, .tags { color: var(--muted); font: .76rem ui-sans-serif, system-ui, sans-serif; }
  h3 { font-size: clamp(1.65rem, 3.4vw, 2.25rem); font-weight: 550; letter-spacing: -.05em; line-height: 1.18; margin: .45rem 0 .7rem; }
  h3 a { text-decoration: none; }
  article p { color: var(--muted); font-size: 1rem; line-height: 1.75; margin: 0 0 1rem; max-width: 42rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem .8rem; }
  .tags a { text-decoration: none; }
  .arrow { align-items: center; border: 1px solid var(--line); border-radius: 999px; display: grid; flex: 0 0 auto; font: 1.25rem ui-sans-serif, system-ui, sans-serif; height: 2.5rem; justify-content: center; text-decoration: none; transition: background-color .15s ease, color .15s ease; width: 2.5rem; }
  .arrow:hover { background: var(--accent); border-color: var(--accent); color: white; }
  @media (hover: hover) { .post-card:hover { transform: translateX(.35rem); } .post-card:hover .arrow { background: var(--accent); border-color: var(--accent); color: white; } }
  @media (max-width: 600px) {
    .intro { padding: 4rem 0 3.5rem; }
    .post-card { gap: 1rem; padding: 1.6rem 0; }
    h3 { font-size: 1.55rem; }
    .arrow { height: 2.25rem; width: 2.25rem; }
  }
</style>
